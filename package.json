{
  "name": "stardust-stellar",
  "version": "0.1.0",
  "description": "Automated browser tests for Stellar apps",
  "keywords": [
    "stellar",
    "soroban",
    "playwright",
    "e2e",
    "testing",
    "wallet",
    "varial",
    "freighter",
    "dapp"
  ],
  "homepage": "https://github.com/chigozzdevv/stardust#readme",
  "bugs": {
    "url": "https://github.com/chigozzdevv/stardust/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chigozzdevv/stardust.git"
  },
  "license": "MIT",
  "author": "Ukpaa Chigozie",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "bin": {
    "stardust": "dist/cli/index.js"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "test": [
        "./dist/test/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "default": "./dist/test/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm build && cd tests/e2e/app && node ../../../dist/cli/index.js test",
    "test:dapps": "pnpm build && node tests/dapps/run.ts",
    "test:conformance": "playwright test -c conformance",
    "conformance:record": "CONFORMANCE_RECORD=1 playwright test -c conformance",
    "api:check": "pnpm build && api-extractor run --print-api-report-diff -c tests/api-report/index.json && api-extractor run --print-api-report-diff -c tests/api-report/test.json",
    "api:update": "pnpm build && api-extractor run --local -c tests/api-report/index.json && api-extractor run --local -c tests/api-report/test.json",
    "site:dev": "pnpm --filter stardust-site dev",
    "site:build": "pnpm --filter stardust-site build"
  },
  "dependencies": {
    "@playwright/test": "^1.65.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@creit.tech/stellar-wallets-kit": "2.8.0",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.60.1",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/varial-sdk": "7.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.27.7",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
